<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        G-Helper exact color scheme (from RForm.cs):
        Dark:  formBack=#1C1C1C  buttonMain=#373737  buttonSecond=#262626  foreMain=#F0F0F0  chartMain=#232323
        Light: SystemColors defaults
        
        We force dark mode and match pixel-perfect.
    -->

    <Style Selector="Window">
        <Setter Property="Background" Value="{DynamicResource WindowBackground}" />
        <Setter Property="Foreground" Value="{DynamicResource TextForeground}" />
        <Setter Property="FontFamily" Value="Segoe UI, Ubuntu, DejaVu Sans, Liberation Sans, sans-serif" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <!-- Panel backgrounds matching G-Helper's dark theme / Matugen surface -->
    <Style Selector="Border.panel">
        <Setter Property="Background" Value="{DynamicResource PanelBackground}" />
        <Setter Property="CornerRadius" Value="5" />
        <Setter Property="Padding" Value="10" />
        <Setter Property="Margin" Value="3" />
    </Style>

    <!-- Buttons matching RButton.cs rounded style (borderRadius=5) -->
    <Style Selector="Button.ghelper">
        <Setter Property="Background" Value="{DynamicResource ButtonBackground}" />
        <Setter Property="Foreground" Value="{DynamicResource TextForeground}" />
        <Setter Property="CornerRadius" Value="5" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style Selector="Button.ghelper:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ButtonHover}" />
    </Style>

    <!-- Active state for ghelper buttons - red-orange border + slightly darker
         fill to match Windows g-helper RButton "activated" appearance
         (colorTurbo). Used by buttonXGM when XG Mobile is currently enabled. -->
    <Style Selector="Button.ghelper.ghelper-active">
        <Setter Property="BorderBrush" Value="#E84B2C" />
        <Setter Property="Background" Value="#3A2A24" />
    </Style>

    <Style Selector="Button.ghelper.ghelper-active:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#4A3530" />
    </Style>

    <!-- Tall mode-selector buttons (perf/GPU) with icon above text -->
    <Style Selector="Button.ghelper-tall">
        <Setter Property="Background" Value="{DynamicResource ButtonBackground}" />
        <Setter Property="Foreground" Value="{DynamicResource TextForeground}" />
        <Setter Property="CornerRadius" Value="5" />
        <Setter Property="Padding" Value="4,8" />
        <Setter Property="MinHeight" Value="68" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style Selector="Button.ghelper-tall:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ButtonHover}" />
    </Style>

    <!-- Wrap long translated labels inside mode buttons -->
    <Style Selector="Button.ghelper-tall TextBlock">
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="TextAlignment" Value="Center" />
    </Style>

    <!-- Gold coin donate button -->
    <Style Selector="Button.ghelper-coin">
        <Setter Property="Background" Value="#FFD700" />
        <Setter Property="Foreground" Value="#4A3800" />
        <Setter Property="CornerRadius" Value="5" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="BorderBrush" Value="#DAA520" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <Style Selector="Button.ghelper-coin:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#FFE44D" />
    </Style>

    <!-- Active mode button border styling -->
    <Style Selector="Button.mode-active">
        <Setter Property="BorderBrush" Value="{DynamicResource AccentColor}" />
        <Setter Property="BorderThickness" Value="2" />
    </Style>

    <Style Selector="Button.fnlock-on">
        <Setter Property="Background" Value="{DynamicResource AccentColor}" />
        <Setter Property="Foreground" Value="{DynamicResource AccentForeground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentColor}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Button.fnlock-on:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentHover}" />
    </Style>

    <Style Selector="Button.audio-on">
        <Setter Property="Background" Value="{DynamicResource AccentColor}" />
        <Setter Property="Foreground" Value="{DynamicResource AccentForeground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentColor}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Button.audio-on:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentHover}" />
    </Style>

    <!-- ComboBox styling -->
    <Style Selector="ComboBox">
        <Setter Property="Background" Value="{DynamicResource ButtonBackground}" />
        <Setter Property="Foreground" Value="{DynamicResource TextForeground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SeparatorColor}" />
        <Setter Property="CornerRadius" Value="5" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style Selector="ComboBox:pointerover /template/ Border#Background">
        <Setter Property="Background" Value="{DynamicResource ButtonHover}" />
    </Style>

    <Style Selector="ComboBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource TextForeground}" />
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style Selector="ComboBoxItem:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ButtonHover}" />
        <Setter Property="Foreground" Value="{DynamicResource TextForeground}" />
    </Style>

    <Style Selector="ComboBoxItem:selected /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentColor}" />
        <Setter Property="Foreground" Value="{DynamicResource AccentForeground}" />
    </Style>

    <Style Selector="ComboBoxItem:selected:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentHover}" />
        <Setter Property="Foreground" Value="{DynamicResource AccentForeground}" />
    </Style>

    <Style Selector="ComboBox /template/ Border#PopupBorder">
        <Setter Property="Background" Value="{DynamicResource PanelBackground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SeparatorColor}" />
    </Style>

    <Style Selector="ComboBox /template/ Popup#PART_Popup Border#PopupBorder">
        <Setter Property="Background" Value="{DynamicResource PanelBackground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SeparatorColor}" />
    </Style>

    <Style Selector="PopupRoot">
        <Setter Property="Background" Value="{DynamicResource PanelBackground}" />
    </Style>

    <Style Selector="MenuFlyoutPresenter">
        <Setter Property="Background" Value="{DynamicResource PanelBackground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SeparatorColor}" />
    </Style>

    <!-- Slider styling -->
    <Style Selector="Slider">
        <Setter Property="Foreground" Value="{DynamicResource AccentColor}" />
    </Style>

    <Style Selector="Slider /template/ Thumb">
        <Setter Property="Background" Value="{DynamicResource AccentColor}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentHover}" />
    </Style>

    <Style Selector="Slider:pointerover /template/ Thumb">
        <Setter Property="Background" Value="{DynamicResource AccentHover}" />
    </Style>

    <!-- CheckBox styling -->
    <Style Selector="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource TextForeground}" />
    </Style>

    <Style Selector="CheckBox:checked /template/ Border#NormalRectangle">
        <Setter Property="Background" Value="{DynamicResource AccentColor}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentColor}" />
    </Style>

    <Style Selector="CheckBox:checked /template/ Path#CheckGlyph">
        <Setter Property="Fill" Value="{DynamicResource AccentForeground}" />
    </Style>

    <Style Selector="CheckBox:checked:pointerover /template/ Border#NormalRectangle">
        <Setter Property="Background" Value="{DynamicResource AccentHover}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentHover}" />
    </Style>

    <!-- RadioButton styling -->
    <Style Selector="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource TextForeground}" />
    </Style>

    <Style Selector="RadioButton:checked /template/ Ellipse#OuterEllipse">
        <Setter Property="Stroke" Value="{DynamicResource AccentColor}" />
        <Setter Property="Fill" Value="{DynamicResource AccentColor}" />
    </Style>

    <Style Selector="RadioButton:checked /template/ Ellipse#CheckGlyph">
        <Setter Property="Fill" Value="{DynamicResource AccentForeground}" />
    </Style>

    <!-- ProgressBar styling -->
    <Style Selector="ProgressBar">
        <Setter Property="Foreground" Value="{DynamicResource AccentColor}" />
        <Setter Property="Background" Value="{DynamicResource ButtonBackground}" />
    </Style>

    <!-- ToggleSwitch styling -->
    <Style Selector="ToggleSwitch:checked /template/ Border#SwitchKnobBounds">
        <Setter Property="Background" Value="{DynamicResource AccentColor}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentColor}" />
    </Style>

    <Style Selector="ToggleSwitch:checked /template/ Canvas#SwitchKnob">
        <Setter Property="Background" Value="{DynamicResource AccentForeground}" />
    </Style>

    <!-- TextBlock defaults -->
    <Style Selector="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextForeground}" />
    </Style>

    <Style Selector="TextBlock.header">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextForeground}" />
    </Style>

    <Style Selector="TextBlock.label-dim">
        <Setter Property="Foreground" Value="{DynamicResource TextDim}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style Selector="TextBlock.value">
        <Setter Property="Foreground" Value="{DynamicResource AccentColor}" />
        <Setter Property="FontSize" Value="11" />
    </Style>

    <!-- SelectableTextBlock styling -->
    <Style Selector="SelectableTextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextForeground}" />
    </Style>

    <Style Selector="SelectableTextBlock.value">
        <Setter Property="Foreground" Value="{DynamicResource AccentColor}" />
        <Setter Property="FontSize" Value="11" />
    </Style>

    <Style Selector="SelectableTextBlock.label-dim">
        <Setter Property="Foreground" Value="{DynamicResource TextDim}" />
        <Setter Property="FontSize" Value="11" />
    </Style>

    <!-- Separator -->
    <Style Selector="Separator">
        <Setter Property="Background" Value="{DynamicResource SeparatorColor}" />
        <Setter Property="Height" Value="1" />
        <Setter Property="Margin" Value="0,5" />
    </Style>

    <!-- TabControl styling for main sections -->
    <Style Selector="TabControl">
        <Setter Property="Background" Value="{DynamicResource WindowBackground}" />
    </Style>

    <Style Selector="TabItem">
        <Setter Property="Foreground" Value="{DynamicResource TextDim}" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <Style Selector="TabItem:selected">
        <Setter Property="Foreground" Value="{DynamicResource TextForeground}" />
    </Style>

    <Style Selector="TabItem:selected /template/ Border#PART_SelectedPipe">
        <Setter Property="Background" Value="{DynamicResource AccentColor}" />
    </Style>

</Styles>
